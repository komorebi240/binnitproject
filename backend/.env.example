# Local development settings for the Spring Boot backend, read by run-local.ps1 at the repository root.
# Copy to backend/.env.local (gitignored) and fill in the blanks. Never commit real values - see CLAUDE.md section 30.
# A variable already set in your shell wins over this file.

# Any random string of 32+ characters. Changing it signs everybody out.
JWT_SECRET=

# SQL Server login for the project_dev database (create it with the sqlcmd lines in README.md, "Running locally").
DB_USERNAME=app_user
DB_PASSWORD=

# Base64 of 32 random bytes, e.g. the output of: openssl rand -base64 32
# Changing it makes already stored Google Drive tokens unreadable.
DRIVE_TOKEN_ENCRYPTION_KEY=

# Base64 of 32 random bytes, e.g. the output of: openssl rand -base64 32
# Encrypts the CRM customer data (a separate key per company is derived from it). Changing or losing it makes the
# stored customer data unreadable, so keep a copy somewhere safe.
CRM_DATA_KEY=

# Google OAuth client. Only a real one lets you link Google Drive; any placeholder is fine otherwise.
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret

# true = OTP and invitation emails are written to the backend window ("[MAIL DEV-LOG]") instead of being sent.
# The application refuses to start with this on under the prod profile.
MAIL_DEV_LOG=true

# To send real email instead, set MAIL_DEV_LOG=false and fill in a Gmail address + App Password (README.md, Phase 4).
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Dev profile only (DevDataSeeder): the mailbox that receives the seed accounts' password-reset codes, and the password
# of the cross-tenant broadcast account orbit_broadcast. Blank = no recovery email / no broadcast account. Never commit values.
DEV_SEED_RECOVERY_EMAIL=
DEV_BROADCAST_PASSWORD=
