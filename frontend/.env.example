# Copy to .env.local (gitignored) and fill real values for your environment.
# Never commit real backend URLs/secrets - see CLAUDE.md section 30.
# "/api/v1" = the browser talks to this Next.js server, which forwards /api to the backend
# (BACKEND_ORIGIN, default http://localhost:8080). Needed for run-public.ps1 and the docker setup.
NEXT_PUBLIC_API_BASE_URL=/api/v1
