# SITE_HOST (e.g. app.stayorbit.cloud) comes from deploy/.env; Caddy gets and renews the TLS certificate itself.
{$SITE_HOST} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Only the API is exposed from the backend: Swagger UI and /actuator stay unreachable from outside.
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
