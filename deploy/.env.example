# Copy to deploy/.env on the server (gitignored). Never commit real values - see CLAUDE.md section 30.

# Public host name, no scheme, e.g. app.stayorbit.cloud (the A record of that name must point at the VM's public IP).
SITE_HOST=

# Azure SQL Database (see docs/deploy-free.md). The login needs rights to create tables (Flyway).
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Fresh random values, NOT the development ones: openssl rand -base64 48  /  openssl rand -base64 32
JWT_SECRET=
DRIVE_TOKEN_ENCRYPTION_KEY=

# Google Drive linking only works with a real OAuth client; leave the placeholders otherwise.
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret

# Gmail address + App Password for OTP and invitation emails (without them, registration and password reset cannot send mail).
SMTP_USERNAME=
SMTP_PASSWORD=
